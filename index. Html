    <script>
        // COLE O LINK DO SEU SCRIPT AQUI (Paste.ee, GitHub, etc)
        const SCRIPT_URL = "https://paste.ee/r/SEU_CODIGO_AQUI";
        
        // Nome do arquivo que vai ser baixado
        const FILENAME = "RattoHub_MEGA.lua";

        function downloadScript() {
            // Mostra notificação
            showNotification("💾 Download iniciado!");

            // Faz o download do script
            fetch(SCRIPT_URL)
                .then(response => response.text())
                .then(scriptCode => {
                    // Cria blob com o código
                    const blob = new Blob([scriptCode], { type: 'text/plain' });
                    const url = window.URL.createObjectURL(blob);
                    
                    // Cria link de download
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = FILENAME;
                    document.body.appendChild(a);
                    a.click();
                    
                    // Limpa
                    document.body.removeChild(a);
                    window.URL.revokeObjectURL(url);

                    // Notifica sucesso após 1 segundo
                    setTimeout(() => {
                        showNotification("✅ Download concluído!");
                    }, 1000);
                })
                .catch(error => {
                    showNotification("❌ Erro no download! Tente novamente.");
                    console.error('Erro:', error);
                });
        }

        function copyKey() {
            const key = "36737829";
            
            // Copia para clipboard
            const temp = document.createElement('textarea');
            temp.value = key;
            document.body.appendChild(temp);
            temp.select();
            document.execCommand('copy');
            document.body.removeChild(temp);

            showNotification("🔑 KEY copiada!");
        }

        function showNotification(message) {
            const notification = document.getElementById('notification');
            notification.textContent = message;
            notification.classList.add('show');
            
            setTimeout(() => {
                notification.classList.remove('show');
            }, 3000);
        }

        // Download automático ao carregar (OPCIONAL - descomente se quiser)
